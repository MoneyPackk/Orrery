{
  // Typechecks the tests, which `tsconfig.json` deliberately excludes.
  //
  // That exclusion is correct: the build emits to `lib/` and the package publishes those
  // directories, so compiling test files would ship them. But excluding them from the build also
  // excluded them from every typecheck, leaving all test files unchecked. A required prop added
  // to a component therefore did not fail its own tests, which is how a stale test keeps passing
  // against an interface it no longer matches.
  //
  // This config emits nothing and exists only to check. Run via `npm run typecheck`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "tsBuildInfoFile": null,
    // Vitest runs these as ES modules, so `import.meta` and JSON imports are legal here even
    // though the published library is CommonJS. Only the checking config differs.
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": []
}
